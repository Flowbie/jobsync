FROM node:22-alpine
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV DATABASE_URL=file:/tmp/eligibility-test.db
RUN npx prisma generate
RUN npx vitest run __tests__/eligibility.spec.ts __tests__/eligibilityEvidence.spec.ts __tests__/eligibilityStorage.spec.ts __tests__/backupRoundTrip.spec.ts
